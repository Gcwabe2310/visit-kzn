# Visit KZN - Environment Variables Example
# ---------------------------------------------------------------------------

# Gemini AI API Key (Required for server-side AI Itinerary Architect)
# AI Studio automatically injects this at runtime from Secrets panel.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase Authentication & Firestore Configuration (Optional client-side config)
VITE_FIREBASE_API_KEY="AIzaSyBtv_fQCNRCajn85u9mgUdVG2PqLp_I7UU"
VITE_FIREBASE_AUTH_DOMAIN="visit-kzn-81e0b.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="visit-kzn-81e0b"
VITE_FIREBASE_STORAGE_BUCKET="visit-kzn-81e0b.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="710014743425"
VITE_FIREBASE_APP_ID="1:710014743425:web:3ae4035c8bef94815cee80"

# Google Maps Platform API Key (Optional for map grounding & geocoding)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted on Cloud Run
APP_URL="MY_APP_URL"
